    "spec/domains/08-offer-and-spec-kit/spec.md"
  ],
  "cli_surface_contract": {
    "registry": "internal/cli/registry.go",
    "error_code_unbound_claim": "E_UNBOUND_CLI_CLAIM",
    "canonical_flag_aliases": {
      "task": ["--task", "--task-id"],
      "paths": ["--paths", "--path", "--files"],
      "receipt": ["--receipt", "--receipt-id"],
      "glob": ["--glob", "--globs", "-g"]
    }
  },
  "documentation_index": {
    "quickstart": "docs/quickstart.md",
    "prd": "docs/PRD.md",
    "srs": "docs/SRS.md",
    "dod_dor": "docs/DOD_DOR.md",
    "architecture_roadmap": "docs/ARCHITECTURE_ROADMAP.md",
    "refactoring_plan": "docs/REFACTORING_PLAN.md",
    "user_guide_mcp": "docs/user-guide/mcp-tools.md",
    "user_guide_cli": "docs/user-guide/cli-reference.md",
    "claims_registry": "docs/claims.yml",
    "skill_supervisor": "skills/g8s-supervisor/SKILL.md",
    "skill_manifest": "skills/manifest.json",
    "offer_readme": "offer/README.md",
    "offer_onboarding": "offer/ONBOARDING.md",
    "offer_scorecard": "offer/SCORECARD.md",
    "offer_search_guide": "offer/SEARCH_GUIDE.md"
  },
  "runtime": {
    "language": "Go 1.26.10",
    "go_version": "1.26.10",
    "cgo_enabled": 0,
    "module": "github.com/tamld/g8s",
    "entrypoint": "cmd/g8s/main.go",
    "sqlite_driver": "modernc.org/sqlite",
    "protocols": [
      "MCP JSON-RPC 2.0 (Stdio)",
      "LSP Client (Stdio)"
    ]
  },
  "roles": [
    {
      "name": "collector",
      "default_permission": "read_only",
      "sow": "Multi-directory file collection and AST tree extraction"
    },
    {
      "name": "scout",
      "default_permission": "read_only",
      "sow": "Codebase scanning, pattern discovery, and MCP candidate mapping"
    },
    {
      "name": "mcp-mapper",
      "default_permission": "read_only",
      "sow": "Tool schema mapping and MCP server discovery"
    },
    {
      "name": "summarizer",
      "default_permission": "read_only",
      "sow": "Log digestion and context compression"
    },
    {
      "name": "verifier",
      "default_permission": "read_only",
      "sow": "Output validation against schemas and physical evidence checks"
    },
    {
      "name": "test-runner",
      "default_permission": "workspace_write",
      "sow": "Unit test synthesis and targeted test suite execution"
    },
    {
      "name": "researcher",
      "default_permission": "read_only",
      "sow": "Deep world-state, CVE/NVD, upstream documentation, and architectural evidence synthesis"
    },
    {
      "name": "implementer",
      "default_permission": "workspace_write",
      "sow": "Bounded code mutations, feature implementations, and bugfixes within WriteReceipt allowed_paths"
    },
    {
      "name": "sec-auditor",
      "default_permission": "read_only",
      "sow": "STRIDE/OWASP/CWE security audits, SSRF/path-traversal/symlink scans, and supply-chain verification"
    },
    {
      "name": "analyst",
      "default_permission": "read_only",
      "sow": "Stakeholder intent decomposition into formal PRD/SRS/AC/FSM contracts and 12D scenario matrices"
    }
  ],
  "permissions": [
    {
      "name": "read_only",
      "allows_mutation": false,
      "requires_receipt": false
    },
    {
      "name": "automation_read",
      "allows_mutation": false,
      "requires_receipt": false,
      "auto_skip_prompts": true
    },
    {
      "name": "workspace_write",
      "allows_mutation": true,
      "requires_receipt": true
    },
    {
      "name": "supplied_text",
      "allows_mutation": false,
      "requires_receipt": false,
      "disables_model_tools": true
    }
  ],
    "schemas": {
      "task": "schemas/task-v1.schema.json",
      "receipt": "schemas/receipt-v1.schema.json",
      "result": "schemas/result-v1.schema.json"
    },
    "architecture_taxonomy": {
      "adr": "docs/decisions/0035-orthogonal-stratum-federation.md",
      "openspec_delta": "DELTA-33",
      "containment_rings": {
        "F0": {
          "name": "Host / Supervisor Ring",
          "description": "Primary checkout & control-plane DB authority; issues receipts and commits verified changes.",
          "env_var": "G8S_TIER=F0"
        },
        "F1": {
          "name": "Isolated Worker Ring",
          "description": "Git worktree + Setpgid OS process group bound to a single-use WriteReceipt.",
          "env_var": "G8S_TIER=F1"
        },
        "F2": {
          "name": "Nested Subagent Ring",
          "description": "Subagent or subtask (depth <= 2) inheriting F1 worktree and receipt ceiling (F2 subset of F1 subset of F0).",
          "env_var": "G8S_TIER=F2"
        }
      },
      "control_strata": {
        "S0": {
          "id": "Principal",
          "ring": "Human / Root",
          "can_mutate_files": false,
          "can_dispatch_strata": ["S1", "S2", "O-Plane"],
          "description": "Human Operator / Board setting strategic outcomes, risk appetite, and capital/quota budgets."
        },
        "S1": {
          "id": "FederationCoordinator",
          "ring": "F0 (Read-Only Repo)",
          "env_var": "G8S_STRATUM=S1",
          "can_mutate_files": false,
          "can_dispatch_strata": ["S2", "O-Plane"],
          "forbidden_actions": ["fsops.Edit", "fsops.VerifyWriteScope", "g8s submit (S3 bypass)"],
          "cli_surface": ["g8s charter issue", "g8s charter verify", "g8s charter revoke", "g8s charter complete", "g8s charter portfolio", "g8s fleet status"],
          "description": "Multi-repository portfolio orchestrator issuing epoch-fenced Charters to S2 DomainGovernors."
        },
        "S2": {
          "id": "DomainGovernor",
          "ring": "F0 (Repo-Scoped)",
          "env_var": "G8S_STRATUM=S2",
          "can_mutate_files": true,
          "can_dispatch_strata": ["S3-M", "S3-A", "O-Plane"],
          "cli_surface": ["g8s brief-issue", "g8s receipt issue", "g8s submit", "g8s worker", "g8s verify", "g8s deliver"],
          "description": "Single-repository sovereign supervisor executing an active S1 Charter."
        },
        "S3-M": {
          "id": "BoundedMutator",
          "ring": "F1 / F2",
          "env_var": "G8S_STRATUM=S3-M",
          "can_mutate_files": true,
          "can_dispatch_strata": [],
          "description": "Isolated worktree coder/tester constrained by single-use WriteReceipt AllowedPaths."
        },
        "S3-A": {
          "id": "BlindAdjudicator",
          "ring": "F1 (Read-Only)",
          "env_var": "G8S_STRATUM=S3-A",
          "can_mutate_files": false,
          "can_dispatch_strata": [],
          "description": "Disjoint-model-family blind verifier operating exclusively on sanitized BlindReviewPacket."
        },
        "O-Plane": {
          "id": "TelemetryProjector",
          "ring": "Deterministic Code",
          "env_var": "G8S_STRATUM=O-Plane",
          "can_mutate_files": false,
          "can_dispatch_strata": [],
          "cli_surface": ["g8s charter portfolio --json", "g8s fleet status --json", "g8s supervisor-metrics --json", "g8s scorecard audit --json", "g8s audit list --json"],
          "description": "Zero-LLM-rewrite read-only SQLite WAL state & portfolio projector."
        }
      },
      "verified_9router_routing": {
        "gateway_provider": "9router",
        "primary_coding_combo": "deep-coding",
        "deep_reasoning_combo": "reasoning-high",
        "fast_retrieval_combo": "docs-retriever",
        "disjoint_blind_adjudicators": [
          "cl/anthropic/claude-sonnet-4.6",
          "cl/anthropic/claude-haiku-4.5",
          "cl/openai/gpt-4.1-mini",
          "cl/google/gemini-2.5-flash"
        ]
      }
    },
