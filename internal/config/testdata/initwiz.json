{
  "version": "1.0",
  "providers": [
    {
      "name": "agy",
      "class": "platform_dispatch",
      "models": [
        {
          "id": "gemini-3.7-flash-high"
        }
      ],
      "slots": 8,
      "args": [
        "agy",
        "--model",
        "{model}",
        "--mode",
        "accept-edits",
        "{prompt}"
      ]
    },
    {
      "name": "claude",
      "class": "platform_dispatch",
      "models": [
        {
          "id": "claude-3-7-sonnet-latest"
        },
        {
          "id": "claude-haiku-4-5"
        }
      ],
      "slots": 2,
      "args": [
        "claude",
        "-p",
        "{prompt}"
      ]
    }
  ]
}
