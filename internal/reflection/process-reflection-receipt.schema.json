{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D9-S2 ProcessReflectionReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id", "cycle", "judge", "verdicts", "add_list", "prune_list", "prune_ratio", "self_tombstone_after"],
  "properties": {
    "receipt_id": {"type": "string", "pattern": "\\S"},
    "cycle": {
      "type": "object", "additionalProperties": false,
      "required": ["timestamp", "trigger"],
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "trigger": {"enum": ["nightly", "release", "manual"]}
      }
    },
    "judge": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "pattern": "\\S"},
        "version": {"type": "string", "pattern": "\\S"}
      }
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_path", "dimension", "verdict", "evidence_refs"],
        "properties": {
          "artifact_path": {"$ref": "#/$defs/path"},
          "dimension": {"enum": ["staleness", "drift", "theater"]},
          "verdict": {"enum": ["healthy", "stale", "drift", "theater"]},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}
        }
      }
    },
    "add_list": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "prune_list": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "prune_ratio": {"type": "number", "minimum": 0, "description": "len(prune_list)/len(add_list), or len(prune_list) when add_list is empty; checked by Go validator."},
    "self_tombstone_after": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$", "not": {"pattern": "(?:^|/)\\.{1,2}(?:/|$)"}},
    "evidence_ref": {
      "type": "string",
      "description": "File suffix is a 1-64 digit hexadecimal SHA prefix or a canonical decimal zero-based ledger byte offset. IDs are nonempty portable opaque identifiers. Shape validation only.",
      "pattern": "^(?:file:[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*@(?:[a-fA-F0-9]{1,64}|0|[1-9][0-9]*)|(?:run|event):[A-Za-z0-9_-][A-Za-z0-9_.-]*)$",
      "not": {"pattern": "(?:^file:|/)\\.{1,2}(?:/|@)"}
    }
  }
}
